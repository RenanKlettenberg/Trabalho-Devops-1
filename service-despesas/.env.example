PORT=3003
DB_HOST=db-despesas
DB_PORT=5432
DB_NAME=despesas_db
DB_USER=usuario
# DB_PASSWORD normalmente vem do secret do Docker (./secrets/db_password.txt);
# defina aqui apenas para rodar fora do docker-compose.
DB_PASSWORD=changeme
# SECRET_JWT normalmente vem do secret do Docker (./secrets/secret_jwt.txt),
# o mesmo usado por service-usuario para assinar os tokens;
# defina aqui apenas para rodar fora do docker-compose.
SECRET_JWT=changeme
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
REDIS_URL=redis://redis:6379
EXCHANGE_API_URL=https://api.exchangerate-api.com/v4/latest
