            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gru_nome\": \"Viagem Floripa\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().payload;",
                  "const grupo = Array.isArray(p) ? p[0] : p;",
                  "if (grupo && grupo.gru_id) pm.environment.set(\"gruId\", grupo.gru_id);",
                  "pm.test(\"Guardou o gruId\", () => pm.expect(pm.environment.get(\"gruId\")).to.exist);"
