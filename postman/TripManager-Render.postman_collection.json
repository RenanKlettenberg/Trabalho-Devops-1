    {
      "name": "3 - Saga (RabbitMQ)",
      "description": "orquestrador -> fila cmd_validar_grupo -> grupos -> fila cmd_registrar_despesa -> despesas -> fila cmd_vincular_despesa_grupo -> grupos",
      "item": [
        {
          "name": "Saga com grupo inexistente (espera 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sagas/despesas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sagas",
                "despesas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Teste grupo inexistente\",\n  \"valor\": 100,\n  \"moeda\": \"BRL\",\n  \"categoria\": \"ALIMENTACAO\",\n  \"viagemId\": \"1\",\n  \"gruId\": 999999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "O 422 é o resultado esperado: o grupos recebeu a pergunta pela fila e respondeu que o grupo não existe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 422\", () => pm.response.to.have.status(422));",
                  "const passo = (pm.response.json().passos || [])[0] || {};",
                  "pm.test(\"Grupos respondeu pela fila (não foi erro de comunicação)\", () => pm.expect(passo.status).to.not.equal(\"ERRO\"));",
                  "console.log(pm.response.json());"
                ]
              }
            }
          ]
        },
        {
          "name": "Saga: despesa dividida no grupo (guarda o desId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sagas/despesas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sagas",
                "despesas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Jantar\",\n  \"valor\": 100,\n  \"moeda\": \"BRL\",\n  \"categoria\": \"ALIMENTACAO\",\n  \"viagemId\": \"1\",\n  \"gruId\": {{gruId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const saga = pm.response.json();",
                  "pm.test(\"Saga concluída\", () => pm.expect(saga.status).to.equal(\"CONCLUIDA\"));",
                  "const reg = (saga.passos || []).find(p => p.nome === \"REGISTRAR_DESPESA\");",
                  "const id = reg && reg.detalhe && reg.detalhe.despesa && reg.detalhe.despesa.id;",
                  "if (id) pm.environment.set(\"desId\", id);",
                  "pm.test(\"Guardou o desId\", () => pm.expect(id).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver a divisão no grupos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/despesa-participante/despesa/{{desId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "despesa-participante",
                "despesa",
                "{{desId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
