                  "pm.test('Gateway devolve 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "// Prova que quem recusou foi o GATEWAY, nao o service-despesas:",
                  "// a mensagem vem do nginx.conf, no campo 'erro'.",
                  "pm.test('Quem recusou foi o gateway, nao o servico', function () {",
                  "    pm.expect(pm.response.json().erro).to.include('API Gateway');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{url_gateway}}/api/despesas",
              "host": [
                "{{url_gateway}}"
              ],
              "path": [
                "api",
